# Copy to .env (make up does this if .env is missing).
# All values are dev-only; production secrets live in AWS Secrets Manager.

# ----- Postgres -----
POSTGRES_USER=vindata
POSTGRES_PASSWORD=vindata
POSTGRES_DB=vindata
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ----- MinIO (S3-compatible) -----
MINIO_ROOT_USER=vindata
MINIO_ROOT_PASSWORD=vindatadev
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_RAW_BUCKET=vindata-raw
MINIO_CURATED_BUCKET=vindata-curated

# ----- API -----
VINDATA_API_HOST=0.0.0.0
VINDATA_API_PORT=8000
VINDATA_API_LOG_LEVEL=info
VINDATA_API_DATABASE_URL=postgresql+asyncpg://vindata:vindata@postgres:5432/vindata
VINDATA_API_CORS_ORIGINS=http://localhost:5173

# ----- Ingest (Dagster) -----
VINDATA_INGEST_DATABASE_URL=postgresql+psycopg://vindata:vindata@postgres:5432/vindata
VINDATA_INGEST_S3_ENDPOINT_URL=http://minio:9000
VINDATA_INGEST_S3_ACCESS_KEY=vindata
VINDATA_INGEST_S3_SECRET_KEY=vindatadev
VINDATA_INGEST_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
VINDATA_INGEST_OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1
DAGSTER_HOME=/opt/dagster/dagster_home

# ----- Web -----
VITE_API_BASE_URL=http://localhost:8000

# ----- Mail (MailHog) -----
SMTP_HOST=mailhog
SMTP_PORT=1025
